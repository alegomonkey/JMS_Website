# Copy to .env and fill in real values. Never commit .env.

# Long random string. Generate with: openssl rand -hex 32
SESSION_SECRET=replace_me_with_openssl_rand_hex_32

# Public domain used by Nginx server_name and CORS allowlist.
# For local dev use: localhost
DOMAIN=localhost

# Email used by Let's Encrypt for renewal notices.
LETSENCRYPT_EMAIL=you@example.com

# Set to "production" on the VPS, "development" locally.
NODE_ENV=development

# Port the API listens on inside its container. Nginx proxies here.
API_PORT=3000

# Optional. Overrides the OAuth redirect base. Defaults to
#   https://${DOMAIN} in production, http://${DOMAIN} otherwise.
# Set to e.g. http://localhost:5173 if your local dev front-end runs there.
PUBLIC_BASE_URL=

# OAuth credentials. Leave blank to disable that provider; the UI will
# hide its button automatically. Configure each provider's app to use
# the redirect URI: ${PUBLIC_BASE_URL}/api/auth/<provider>/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
