# Copy to .env and fill in real values. Never commit .env.

# Long random string. Generate with: openssl rand -hex 32
SESSION_SECRET=replace_me_with_openssl_rand_hex_32

# Public domain used by Nginx server_name and CORS allowlist.
# For local dev use: localhost
DOMAIN=localhost

# Email used by Let's Encrypt for renewal notices.
LETSENCRYPT_EMAIL=you@example.com

# Set to "production" on the VPS, "development" locally.
NODE_ENV=development

# Port the API listens on inside its container. Nginx proxies here.
API_PORT=3000
